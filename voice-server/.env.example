# ── Required ───────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Provider selection ─────────────────────────────────────────────────────────
# STT_PROVIDER: "local" (faster-whisper, needs CUDA GPU) | "groq" (cloud, just needs GROQ_API_KEY)
STT_PROVIDER=local

# TTS_PROVIDER: "local" (Piper, CPU-only, voices auto-downloaded) | "groq" (cloud Orpheus TTS)
TTS_PROVIDER=local
